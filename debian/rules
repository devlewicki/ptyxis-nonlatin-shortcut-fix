#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_LDFLAGS_MAINT_APPEND = -Wl,-O1 -Wl,-z,defs

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -Dgeneric=terminal

ifeq (yes,$(shell dpkg-vendor --derives-from Ubuntu && echo yes))
execute_before_dh_auto_configure:
	# Set Ubuntu palette as default
	cp debian/ptyxis.gsettings-override debian/.ptyxis.gsettings-override
	sed -i "/\[org.gnome.Ptyxis.Profile\]/a palette='Ubuntu'" debian/ptyxis.gsettings-override
execute_before_dh_clean:
	mv debian/.ptyxis.gsettings-override debian/ptyxis.gsettings-override || :
endif

# Skip. We only use dh_gnome for dh_translations for Ubuntu
override_dh_gnome:
